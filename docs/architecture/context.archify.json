  "cards": [
    {
      "dot": "cyan",
      "title": "Cuándo ocurre cada conexión",
      "items": [
        "Bolsas públicas y Apify: cuando la persona lanza una lectura",
        "Correo: al terminar una recolección, solo con el aviso encendido",
        "Sitio público: al pedir /cv sin una versión vigente",
        "Lector local: ninguna fuente se lee hoy desde la máquina"
      ]
    },
    {
      "dot": "emerald",
      "title": "Qué no es",
      "items": [
        "No escribe a nadie más que a la persona",
        "No corre en varias instancias: el candado vive en memoria",
        "No lee nada solo: la programada viene apagada"
      ]
    },
